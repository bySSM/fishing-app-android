<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:gravity="center_horizontal"

        android:paddingStart="@dimen/screen_padding_large"
        android:paddingEnd="@dimen/screen_padding_large"
        android:paddingTop="@dimen/spacing_xxl"
        android:paddingBottom="@dimen/spacing_xxl">


        <!-- ================================================= -->
        <!-- Заголовок                                           -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Регистрация"

            android:textColor="@color/primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"

            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_xl"

            android:text="Создай аккаунт и сохраняй свои уловы"

            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_secondary"

            android:gravity="center" />


        <!-- ================================================= -->
        <!-- Логин                                               -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/regUsernameInput"

            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"

            android:background="@drawable/bg_input"

            android:hint="Логин (мин. 3 символа)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"

            android:inputType="text"
            android:textSize="@dimen/text_body"

            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"

            android:singleLine="true" />


        <!-- ================================================= -->
        <!-- Email                                               -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/regEmailInput"

            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"

            android:layout_marginTop="@dimen/spacing_small"

            android:background="@drawable/bg_input"

            android:hint="Email"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"

            android:inputType="textEmailAddress"
            android:textSize="@dimen/text_body"

            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"

            android:singleLine="true" />


        <!-- ================================================= -->
        <!-- Пароль                                              -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/regPasswordInput"

            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"

            android:layout_marginTop="@dimen/spacing_small"

            android:background="@drawable/bg_input"

            android:hint="Пароль (мин. 6 символов)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"

            android:inputType="textPassword"
            android:textSize="@dimen/text_body"

            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"

            android:singleLine="true" />


        <!-- ================================================= -->
        <!-- Повтор пароля                                       -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/regConfirmPasswordInput"

            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"

            android:layout_marginTop="@dimen/spacing_small"

            android:background="@drawable/bg_input"

            android:hint="Повторите пароль"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"

            android:inputType="textPassword"
            android:textSize="@dimen/text_body"

            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"

            android:singleLine="true" />


        <!-- ================================================= -->
        <!-- Регистрация                                         -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/submitRegisterButton"

            style="@style/FishingApp.Button.Primary"

            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"

            android:layout_marginTop="@dimen/spacing_large"

            android:text="Зарегистрироваться" />


        <!-- ================================================= -->
        <!-- Назад                                               -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/backToLoginButton"

            style="@style/FishingApp.Button.Secondary"

            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"

            android:layout_marginTop="@dimen/spacing_small"

            android:text="Назад ко входу" />

    </LinearLayout>

</ScrollView>
