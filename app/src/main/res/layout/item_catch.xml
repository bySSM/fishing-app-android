<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="@dimen/spacing_medium"
    android:layout_marginEnd="@dimen/spacing_medium"
    android:layout_marginTop="@dimen/spacing_small"
    android:layout_marginBottom="@dimen/spacing_small"

    android:backgroundTint="@color/surface"

    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <!-- Фото улова -->
        <ImageView
            android:id="@+id/catchImageView"

            android:layout_width="108dp"
            android:layout_height="108dp"

            android:background="@color/surface_variant"
            android:contentDescription="Фото улова"
            android:scaleType="centerCrop" />

        <!-- Правая часть карточки -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:layout_marginStart="@dimen/spacing_medium"

            android:orientation="vertical">

            <!-- Вид рыбы -->
            <TextView
                android:id="@+id/fishTypeTextView"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Щука"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_subheading"
                android:textStyle="bold"

                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Вес -->
            <TextView
                android:id="@+id/weightTextView"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/spacing_xs"

                android:text="3.5 кг"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <!-- Дата -->
            <TextView
                android:id="@+id/dateTextView"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/spacing_xs"

                android:text="20.08.2026"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <!-- Социальные действия -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/spacing_small"

                android:orientation="horizontal">

                <Button
                    android:id="@+id/likeButton"

                    style="@style/FishingApp.Button.Text"

                    android:layout_width="wrap_content"
                    android:layout_height="40dp"

                    android:minWidth="0dp"
                    android:minHeight="0dp"

                    android:paddingStart="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_small"

                    android:text="❤️ 0"
                    android:textSize="@dimen/text_caption" />

                <Button
                    android:id="@+id/commentsButton"

                    style="@style/FishingApp.Button.Text"

                    android:layout_width="wrap_content"
                    android:layout_height="40dp"

                    android:layout_marginStart="@dimen/spacing_xs"

                    android:minWidth="0dp"
                    android:minHeight="0dp"

                    android:paddingStart="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_small"

                    android:text="💬 Комментарии"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

            <!-- Редактирование / удаление -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/spacing_xs"

                android:orientation="horizontal">

                <Button
                    android:id="@+id/editButton"

                    style="@style/FishingApp.Button.Text"

                    android:layout_width="40dp"
                    android:layout_height="40dp"

                    android:minWidth="0dp"
                    android:minHeight="0dp"

                    android:padding="0dp"

                    android:text="✏️"
                    android:textSize="16sp"
                    android:contentDescription="Редактировать улов" />

                <Button
                    android:id="@+id/deleteButton"

                    style="@style/FishingApp.Button.Text"

                    android:layout_width="40dp"
                    android:layout_height="40dp"

                    android:layout_marginStart="@dimen/spacing_xs"

                    android:minWidth="0dp"
                    android:minHeight="0dp"

                    android:padding="0dp"

                    android:text="🗑️"
                    android:textSize="16sp"
                    android:textColor="@color/error"
                    android:contentDescription="Удалить улов" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

