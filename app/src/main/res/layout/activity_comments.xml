<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Шапка -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small"
        android:background="@color/surface"
        android:elevation="2dp">

        <Button
            android:id="@+id/backButton"
            style="@style/FishingApp.Button.Text"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textSize="22sp"
            android:gravity="center"
            android:contentDescription="Назад" />

        <TextView
            android:id="@+id/commentsTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_xs"
            android:text="Комментарии"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold"
            android:gravity="center_vertical" />

    </LinearLayout>


    <!-- Название улова -->

    <TextView
        android:id="@+id/catchTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small"
        android:text="Щука"
        android:textColor="@color/primary"
        android:textSize="@dimen/text_subheading"
        android:textStyle="bold" />


    <!-- Список комментариев -->

    <ListView
        android:id="@+id/commentsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_small"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/spacing_small"
        android:background="@color/background" />


    <!-- Новый комментарий -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_small"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small"
        android:background="@color/surface"
        android:elevation="4dp">

        <EditText
            android:id="@+id/commentEditText"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_height"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Написать комментарий..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1000"
            android:minHeight="0dp"
            android:gravity="top|start"
            android:padding="@dimen/spacing_medium" />

        <Button
            android:id="@+id/sendCommentButton"
            style="@style/FishingApp.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"
            android:text="Отправить"
            android:textSize="@dimen/text_caption"
            android:gravity="center"
            android:singleLine="true" />

    </LinearLayout>

</LinearLayout>