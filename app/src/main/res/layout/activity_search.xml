<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">


    <!-- Шапка -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small"
        android:background="@color/primary"
        android:elevation="4dp">


        <Button
            android:id="@+id/backButton"
            style="@style/FishingApp.Button.Text"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:minWidth="0dp"
            android:minHeight="0dp"

            android:padding="0dp"

            android:text="←"
            android:textSize="22sp"
            android:textColor="@color/text_on_primary"

            android:gravity="center" />


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_small"

            android:text="Поиск пользователей"

            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold" />


    </LinearLayout>


    <!-- Поиск -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:padding="@dimen/spacing_medium">


        <EditText
            android:id="@+id/searchInput"

            android:layout_width="0dp"
            android:layout_height="@dimen/input_height"

            android:layout_weight="1"

            android:background="@drawable/bg_input"

            android:hint="Введи имя пользователя"

            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"

            android:inputType="text"

            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium" />


        <Button
            android:id="@+id/searchButton"

            style="@style/FishingApp.Button.Primary"

            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"

            android:layout_marginStart="@dimen/spacing_small"

            android:minWidth="0dp"
            android:minHeight="0dp"

            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"

            android:text="Найти"

            android:textSize="@dimen/text_caption"

            android:gravity="center" />


    </LinearLayout>


    <!-- Результаты -->

    <ListView
        android:id="@+id/searchResultsListView"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_medium"

        android:clipToPadding="false"

        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/spacing_small"

        android:background="@color/background" />


    <!-- Нет результатов -->

    <TextView
        android:id="@+id/emptyResultTextView"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Введи запрос для поиска"

        android:textColor="@color/text_secondary"

        android:textSize="@dimen/text_body"

        android:gravity="center"

        android:padding="@dimen/spacing_large"

        android:visibility="gone" />


</LinearLayout>