<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Шапка рейтинга -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_small"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_medium"
        android:background="@color/primary"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏆 Рейтинг рыбаков"
                android:textColor="@color/text_on_primary"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Лучшие результаты сообщества"
                android:textColor="@color/primary_light"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

        <Button
            android:id="@+id/backButton"
            style="@style/FishingApp.Button.Text"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textSize="22sp"
            android:textColor="@color/text_on_primary"
            android:gravity="center"
            android:contentDescription="Назад" />

    </LinearLayout>


    <!-- Акцентная полоска -->

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/rating_gold" />


    <!-- Список рейтинга -->

    <ListView
        android:id="@+id/ratingListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_medium"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/spacing_small"
        android:background="@color/background" />

</LinearLayout>