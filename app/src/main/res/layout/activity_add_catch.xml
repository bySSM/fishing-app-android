<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xxl">


        <!-- ================================================= -->
        <!-- Заголовок                                           -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Новый улов"

            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_large"

            android:text="Добавь фотографию и информацию о своей рыбалке"

            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_secondary" />


        <!-- ================================================= -->
        <!-- Фото                                                -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/catchPhotoPreview"

            android:layout_width="match_parent"
            android:layout_height="220dp"

            android:layout_gravity="center"

            android:background="@color/surface_variant"

            android:contentDescription="Фото улова"

            android:scaleType="centerCrop" />


        <!-- ================================================= -->
        <!-- Выбор фотографии                                   -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_large"

            android:orientation="horizontal">

            <Button
                android:id="@+id/selectPhotoButton"

                style="@style/FishingApp.Button.Secondary"

                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"

                android:minWidth="0dp"
                android:minHeight="0dp"

                android:paddingStart="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_small"

                android:insetTop="0dp"
                android:insetBottom="0dp"

                android:text="📁 Галерея"
                android:textSize="@dimen/text_secondary" />

            <Button
                android:id="@+id/takePhotoButton"

                style="@style/FishingApp.Button.Secondary"

                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"

                android:layout_marginStart="@dimen/spacing_small"

                android:minWidth="0dp"
                android:minHeight="0dp"

                android:paddingStart="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_small"

                android:insetTop="0dp"
                android:insetBottom="0dp"

                android:text="📸 Камера"
                android:textSize="@dimen/text_secondary" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Местоположение                                     -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginBottom="@dimen/spacing_small"

            android:text="Местоположение"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subheading"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"

            android:orientation="horizontal">

            <TextView
                android:id="@+id/locationTextView"

                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"

                android:layout_weight="1"

                android:background="@drawable/bg_input"

                android:gravity="center_vertical"

                android:paddingStart="@dimen/spacing_medium"
                android:paddingEnd="@dimen/spacing_medium"

                android:text="📍 Определение..."
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_secondary" />

            <Button
                android:id="@+id/getLocationButton"

                style="@style/FishingApp.Button.Text"

                android:layout_width="wrap_content"
                android:layout_height="48dp"

                android:layout_marginStart="@dimen/spacing_small"

                android:minWidth="0dp"
                android:minHeight="0dp"

                android:paddingStart="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_small"

                android:insetTop="0dp"
                android:insetBottom="0dp"

                android:text="📍 Обновить"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Скрытие геолокации                                 -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_large"

            android:gravity="center_vertical"

            android:orientation="horizontal">

            <Switch
                android:id="@+id/hideLocationSwitch"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Скрыть местоположение"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_secondary" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Вид рыбы                                           -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginBottom="@dimen/spacing_xs"

            android:text="Вид рыбы *"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_secondary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/fishTypeInput"

            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"

            android:background="@drawable/bg_input"

            android:hint="Например: Щука, Окунь, Судак"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"

            android:inputType="text"
            android:textSize="@dimen/text_body"

            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"

            android:singleLine="true" />


        <!-- ================================================= -->
        <!-- Вес                                                 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_xs"

            android:text="Вес (кг)"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_secondary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/weightInput"

            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"

            android:background="@drawable/bg_input"

            android:hint="Например: 3.5"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"

            android:inputType="numberDecimal"
            android:textSize="@dimen/text_body"

            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"

            android:singleLine="true" />


        <!-- ================================================= -->
        <!-- Длина                                               -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_xs"

            android:text="Длина (см)"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_secondary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/lengthInput"

            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"

            android:background="@drawable/bg_input"

            android:hint="Например: 65"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"

            android:inputType="numberDecimal"
            android:textSize="@dimen/text_body"

            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"

            android:singleLine="true" />


        <!-- ================================================= -->
        <!-- Наживка                                              -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_xs"

            android:text="Наживка"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_secondary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/baitInput"

            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"

            android:background="@drawable/bg_input"

            android:hint="Например: Воблер, Червь, Блесна"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"

            android:inputType="text"
            android:textSize="@dimen/text_body"

            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"

            android:singleLine="true" />


        <!-- ================================================= -->
        <!-- Описание                                            -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_xs"

            android:text="Описание"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_secondary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/descriptionInput"

            android:layout_width="match_parent"
            android:layout_height="120dp"

            android:background="@drawable/bg_input"

            android:hint="Расскажи, как поймал"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"

            android:inputType="textMultiLine"
            android:gravity="top|start"

            android:textSize="@dimen/text_body"

            android:padding="@dimen/spacing_medium" />


        <!-- ================================================= -->
        <!-- Сохранить                                           -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/saveCatchButton"

            style="@style/FishingApp.Button.Primary"

            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"

            android:layout_marginTop="@dimen/spacing_xl"

            android:text="Сохранить улов" />


        <!-- ================================================= -->
        <!-- Отмена                                              -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/cancelButton"

            style="@style/FishingApp.Button.Secondary"

            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"

            android:layout_marginTop="@dimen/spacing_small"

            android:text="Отмена" />

    </LinearLayout>

</ScrollView>
