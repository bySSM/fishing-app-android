<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aquarium_background">

    <!-- ========================================================= -->
    <!-- HEADER                                                     -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/aquarium_dark"
        android:elevation="4dp">

        <TextView
            android:id="@+id/aquariumTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Мой аквариум"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/aquariumUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Аквариум"
            android:textColor="#B3E5FC"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- AQUARIUM                                                   -->
    <!-- ========================================================= -->

    <FrameLayout
        android:id="@+id/aquariumContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_aquarium_water"
        android:clipChildren="true"
        android:clipToPadding="true">


        <!-- ===================================================== -->
        <!-- LIGHT RAYS                                             -->
        <!-- ===================================================== -->

        <View
            android:layout_width="180dp"
            android:layout_height="500dp"
            android:layout_gravity="top|start"
            android:alpha="0.08"
            android:rotation="-18"
            android:background="@drawable/bg_aquarium_light_ray" />

        <View
            android:layout_width="160dp"
            android:layout_height="520dp"
            android:layout_gravity="top|center_horizontal"
            android:alpha="0.06"
            android:rotation="7"
            android:background="@drawable/bg_aquarium_light_ray" />

        <View
            android:layout_width="180dp"
            android:layout_height="500dp"
            android:layout_gravity="top|end"
            android:alpha="0.07"
            android:rotation="20"
            android:background="@drawable/bg_aquarium_light_ray" />


        <!-- ===================================================== -->
        <!-- BACKGROUND BUBBLES                                    -->
        <!-- ===================================================== -->

        <View
            android:id="@+id/bubble1"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="34dp"
            android:layout_marginTop="80dp"
            android:alpha="0.55"
            android:background="@drawable/bg_bubble" />

        <View
            android:id="@+id/bubble2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="65dp"
            android:layout_marginTop="145dp"
            android:alpha="0.45"
            android:background="@drawable/bg_bubble" />

        <View
            android:id="@+id/bubble3"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="48dp"
            android:layout_marginTop="110dp"
            android:alpha="0.50"
            android:background="@drawable/bg_bubble" />

        <View
            android:id="@+id/bubble4"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="76dp"
            android:layout_marginTop="165dp"
            android:alpha="0.40"
            android:background="@drawable/bg_bubble" />


        <!-- ===================================================== -->
        <!-- BACKGROUND PLANTS                                     -->
        <!-- ===================================================== -->

        <ImageView
            android:layout_width="100dp"
            android:layout_height="190dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-10dp"
            android:layout_marginBottom="28dp"
            android:src="@drawable/bg_aquarium_algae"
            android:alpha="0.82"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="90dp"
            android:layout_height="170dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-8dp"
            android:layout_marginBottom="30dp"
            android:src="@drawable/bg_aquarium_algae"
            android:alpha="0.72"
            android:rotation="8"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />


        <!-- ===================================================== -->
        <!-- BACKGROUND ROCKS                                      -->
        <!-- ===================================================== -->

        <ImageView
            android:layout_width="115dp"
            android:layout_height="70dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="22dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/bg_aquarium_rocks"
            android:alpha="0.95"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="100dp"
            android:layout_height="65dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="7dp"
            android:src="@drawable/bg_aquarium_rocks"
            android:alpha="0.90"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />


        <!-- ===================================================== -->
        <!-- FISH LAYER                                             -->
        <!-- ===================================================== -->

        <FrameLayout
            android:id="@+id/aquariumFishContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true" />


        <!-- ===================================================== -->
        <!-- GLASS HIGHLIGHT                                       -->
        <!-- ===================================================== -->

        <View
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_aquarium_surface" />

        <!-- bottom sand -->
        <View
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_aquarium_sand" />

    </FrameLayout>


    <!-- ========================================================= -->
    <!-- BOTTOM NAVIGATION                                         -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:elevation="12dp">

        <Button
            android:id="@+id/navMyCatchesButton"
            style="@style/FishingApp.Button.Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🎣\nУлов"
            android:textSize="11sp"
            android:gravity="center" />

        <Button
            android:id="@+id/navRatingButton"
            style="@style/FishingApp.Button.Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🏆\nРейтинг"
            android:textSize="11sp"
            android:gravity="center" />

        <Button
            android:id="@+id/navSearchButton"
            style="@style/FishingApp.Button.Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔍\nПоиск"
            android:textSize="11sp"
            android:gravity="center" />

        <Button
            android:id="@+id/navCommunityButton"
            style="@style/FishingApp.Button.Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="👥\nЛюди"
            android:textSize="11sp"
            android:gravity="center" />

        <Button
            android:id="@+id/navSettingsButton"
            style="@style/FishingApp.Button.Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙️"
            android:textSize="18sp"
            android:gravity="center" />

        <Button
            android:id="@+id/navMapButton"
            style="@style/FishingApp.Button.Text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🗺\nКарта"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>