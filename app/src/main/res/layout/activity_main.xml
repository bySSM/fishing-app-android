<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:gravity="center"

    android:background="@color/background"

    android:paddingStart="@dimen/screen_padding_large"
    android:paddingEnd="@dimen/screen_padding_large"
    android:paddingTop="@dimen/spacing_xxl"
    android:paddingBottom="@dimen/spacing_xxl">


    <!-- ===================================================== -->
    <!-- Заголовок                                               -->
    <!-- ===================================================== -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Fishing App"

        android:textColor="@color/primary"
        android:textSize="30sp"
        android:textStyle="bold"

        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_xxl"

        android:text="Твои уловы. Твоя история."

        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_secondary"

        android:gravity="center" />


    <!-- ===================================================== -->
    <!-- Логин                                                   -->
    <!-- ===================================================== -->

    <EditText
        android:id="@+id/usernameInput"

        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"

        android:background="@drawable/bg_input"

        android:hint="Логин"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"

        android:inputType="text"
        android:textSize="@dimen/text_body"

        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"

        android:singleLine="true" />


    <!-- ===================================================== -->
    <!-- Пароль                                                  -->
    <!-- ===================================================== -->

    <EditText
        android:id="@+id/passwordInput"

        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"

        android:layout_marginTop="@dimen/spacing_medium"

        android:background="@drawable/bg_input"

        android:hint="Пароль"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"

        android:inputType="textPassword"
        android:textSize="@dimen/text_body"

        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"

        android:singleLine="true" />


    <!-- ===================================================== -->
    <!-- Войти                                                    -->
    <!-- ===================================================== -->

    <Button
        android:id="@+id/loginButton"

        style="@style/FishingApp.Button.Primary"

        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"

        android:layout_marginTop="@dimen/spacing_large"

        android:text="Войти" />


    <!-- ===================================================== -->
    <!-- Регистрация                                              -->
    <!-- ===================================================== -->

    <Button
        android:id="@+id/registerButton"

        style="@style/FishingApp.Button.Secondary"

        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"

        android:layout_marginTop="@dimen/spacing_small"

        android:text="Зарегистрироваться" />

</LinearLayout>