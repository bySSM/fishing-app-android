<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="220dp"
    android:layout_height="wrap_content"

    android:clickable="true"
    android:focusable="true"

    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_small">

        <!-- ===================================================== -->
        <!-- Фото                                                   -->
        <!-- ===================================================== -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp">

            <ImageView
                android:id="@+id/catchPhotoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="@color/surface_variant"
                android:contentDescription="@string/catch_photo_cd"
                android:scaleType="centerCrop" />

            <!-- Текст при отсутствии фотографии -->
            <TextView
                android:id="@+id/noPhotoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center"

                android:text="@string/catch_no_photo"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"

                android:visibility="gone" />

            <!-- Кнопка закрытия -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/closeInfoButton"

                android:layout_width="36dp"
                android:layout_height="36dp"

                android:layout_gravity="top|end"

                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_cd"
                android:padding="6dp"

                app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_primary" />

        </FrameLayout>


        <!-- ===================================================== -->
        <!-- Информация об улове                                    -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/fishTypeText"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_small"

            android:ellipsize="end"
            android:maxLines="1"

            android:textColor="@color/primary"
            android:textSize="@dimen/text_subheading"
            android:textStyle="bold" />


        <!-- Вес -->
        <TextView
            android:id="@+id/weightText"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_xs"

            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_secondary"
            android:textStyle="bold" />


        <!-- Автор -->
        <TextView
            android:id="@+id/usernameText"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:ellipsize="end"
            android:maxLines="1"

            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />


        <!-- ===================================================== -->
        <!-- Переход к подробностям                                -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tapHintText"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_small"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"

            android:text="@string/catch_view_details"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
